# Clé Web3Forms, obtenue sur https://web3forms.com.
#
# Elle est publique par conception : Web3Forms attend un envoi depuis le
# navigateur et bloque les appels venant d'un serveur. Le préfixe
# NEXT_PUBLIC la rend donc lisible par la page, c'est voulu. Elle ne
# permet rien d'autre que d'écrire dans la boîte du compte.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Clé de l'API Gemini, pour la démonstration de tri des demandes.
# Obtenue gratuitement sur https://aistudio.google.com/apikey
#
# Sans elle, la démonstration continue de fonctionner : elle bascule sur
# un classement de secours par règles. Contrairement à la clé Web3Forms,
# celle-ci est un vrai secret : pas de préfixe NEXT_PUBLIC, elle ne doit
# jamais atteindre le navigateur.
GEMINI_API_KEY=
